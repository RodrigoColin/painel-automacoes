# === Template de credenciais para migração CA -> Omie ===
# Copie para a pasta do cliente como .env.local e preencha. NUNCA commitar o .env.local real.

# --- Conta Azul API v2 (OAuth2 Authorization Code) ---
CONTAAZUL_CLIENT_ID=
CONTAAZUL_CLIENT_SECRET=
CONTAAZUL_AMBIENTE=producao
CONTAAZUL_REDIRECT_URI=https://www.contaazul.com
CONTAAZUL_STATE=migracao
CONTAAZUL_AUTHORIZE_URL=https://login.contaazul.com/#/oauth/authorize
CONTAAZUL_TOKEN_URL=https://api-v2.contaazul.com/oauth/token
CONTAAZUL_SCOPE=openid profile aws.cognito.signin.user.admin
CONTAAZUL_API_BASE=https://api-v2.contaazul.com
# access token expira em 1h; renovar via grant_type=refresh_token (Basic base64(client_id:secret))

# --- Omie API (REST) ---
OMIE_APP_KEY=
OMIE_APP_SECRET=
# app_hash da empresa (para o MCP oficial): obter via omie_listar_apps
OMIE_APP_HASH=
