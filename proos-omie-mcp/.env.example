# Copie este arquivo para ".env" e preencha com as credenciais reais.
# NUNCA faça commit do arquivo ".env" com credenciais reais (adicione ao
# .gitignore).

# Como obter: developer.omie.com.br > Aplicativos > selecione o app
# (ou dentro do Omie: card do app > engrenagem > "Resumo do App" >
# "Chave de Integração (API)"). Apenas usuários administradores da conta
# conseguem ver/gerar essas chaves.
OMIE_APP_KEY=
OMIE_APP_SECRET=

# Opcionais (valores padrão já são razoáveis para uso normal)
# OMIE_BASE_URL=https://app.omie.com.br/api/v1
# OMIE_MAX_REQUESTS_PER_SECOND=3
# OMIE_MAX_RETRIES=4
# OMIE_TIMEOUT_SECONDS=30

# Só necessário se for usar a flag --banco (grava os dados também num
# Postgres, além de/em vez do Excel — ver omie_mcp/db.py, db/schema.sql e
# SETUP_BANCO.md). Sem esta variável definida, --banco avisa e é ignorado;
# os scripts continuam funcionando normalmente só com Excel.
# DATABASE_URL=postgresql://usuario:senha@host:5432/proos_omie
