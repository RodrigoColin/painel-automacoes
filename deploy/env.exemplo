# Modelo de /opt/painel/.env na VPS. Copie, preencha e deixe com `chmod 600`.
#
# Senhas e segredos: use `openssl rand -hex 32` — hexadecimal não precisa de
# escape dentro das URLs de conexão do docker-compose.

# Superusuário do Postgres do painel (migrações e backup).
POSTGRES_PASSWORD=

# Papel com que o app se conecta (`painel_app`).
PAINEL_APP_PASSWORD=

# Bearer das rotas de cron (/api/agendador, /api/sincronizar-*).
CRON_SECRET=

# Segredo compartilhado entre o app e o container do executor Python.
EXECUTOR_SECRET=

# Machine Identity do Infisical (Universal Auth). Mesmos valores da Vercel.
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# Disparos do cron (agendador, n8n, Omie). Fica `false` enquanto a produção
# antiga (Vercel + Supabase) estiver no ar: com os dados copiados, as mesmas
# automações rodariam duas vezes. Vira `true` na virada. O backup roda sempre.
CRON_ATIVO=false

# Preenchido pelo deploy (deploy/atualizar.sh) — não edite à mão.
PAINEL_VERSAO=
